<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AuraVault.App.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AuraVault/Theme/Controls.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="AppFont">avares://Avalonia.Fonts.Inter/Assets#Inter, $Default</FontFamily>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AuraVault/Theme/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
