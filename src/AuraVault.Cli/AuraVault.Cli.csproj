<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AuraVault.Cli</RootNamespace>
    <AssemblyName>auravault</AssemblyName>
    <Description>Headless CLI for AuraVault: create a vault, import CSV/XLSX exports, search, generate passwords.</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuraVault.Core\AuraVault.Core.csproj" />
  </ItemGroup>

</Project>
